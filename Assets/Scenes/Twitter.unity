--- !u!114 &1560221412
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1560221411}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 78bdae3b9f088ed49a031b4600b07967, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::EntryListImporter
  EntriesCSV: {fileID: 4900000, guid: 39c26b9c1ea48dc4096230d9c1c8aaab, type: 3}
  EntryPrefab: {fileID: 3603475336980037573, guid: b8da11161eb999d408b468efeb44a1f4, type: 3}
  EntryListParent: {fileID: 763994099}
  scrollArea: {fileID: 763994099}
  filters:
  - Twitter
  distanceBetweenEntries: 40
  entriesPadding: 40
  entriesData:
  - filter: App
    title: Title
    description: Description
    steps:
    - Steps
  - filter: Instagram
    title: Private Account
    description: Restrict posts and profile visibility to approved followers only
    steps:
    - '"1. Open Profile'
    - 2. Tap Menu icon
    - 3. Go to Settings and Privacy
    - 4. Tap Account Privacy
    - 5. Toggle Private Account on"
  - filter: Instagram
    title: Activity Status Off
    description: Hide your last seen and online status from other users
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Messages and Story Replies
    - 3. Toggle Show Activity Status off"
  - filter: Instagram
    title: Disable Story Resharing
    description: Prevent others from resharing your stories to their own
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Story
    - 3. Toggle Allow Resharing to Stories off"
  - filter: Instagram
    title: Manual Tag Approval
    description: Review and approve tags before they appear on your profile
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Tags and Mentions
    - 3. Set Allow Tags to Manually Approve"
  - filter: Instagram
    title: Limit Ad Data Usage
    description: Reduce data used for ad targeting under Ad Preferences
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Ads
    - 3. Tap Ad Topics
    - 4. Turn off unwanted topics"
  - filter: Instagram
    title: Two-Factor Authentication
    description: Enable 2FA using an authenticator app instead of SMS
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Accounts Center
    - 3. Tap Password and Security
    - 4. Tap Two-Factor Authentication
    - 5. Select Authentication App"
  - filter: Instagram
    title: Review Login Activity
    description: Check and log out unrecognized active sessions
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Accounts Center
    - 3. Tap Password and Security
    - 4. Tap Where You Are Logged In
    - 5. Log out unrecognized devices"
  - filter: Instagram
    title: Revoke Third-Party App Access
    description: Remove unused apps and websites connected to your account
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Accounts Center
    - 3. Tap Apps and Websites
    - 4. Remove unused connections"
  - filter: Instagram
    title: Strip Location From Posts
    description: Disable precise location sharing for the app in OS settings
    steps:
    - '"1. Open phone Settings'
    - 2. Go to Apps or Privacy
    - 3. Select Instagram
    - 4. Set Location permission to Never or While Using with Precise Location off"
  - filter: Instagram
    title: Download Your Information
    description: Periodically audit stored data via the data export tool
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Accounts Center
    - 3. Tap Your Information and Permissions
    - 4. Tap Download Your Information
    - 5. Request export"
  - filter: Twitter
    title: Protect Your Posts
    description: Make your account private so only approved followers see posts
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Audience and Tagging
    - 4. Toggle Protect Your Posts on"
  - filter: Twitter
    title: Photo Tagging Restriction
    description: Limit who can tag you in photos to people you follow
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Audience and Tagging
    - 4. Set Photo Tagging to People You Follow"
  - filter: Twitter
    title: Disable Discoverability
    description: Prevent others from finding your account via email or phone
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Discoverability and Contacts
    - 4. Turn off email and phone discoverability"
  - filter: Twitter
    title: Turn Off Ad Personalization
    description: Disable use of off-platform activity for ad targeting
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Ads Preferences
    - 4. Turn off Personalized Ads"
  - filter: Twitter
    title: Remove Location From Posts
    description: Stop attaching location metadata to tweets
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Location Information
    - 4. Turn off Add Location to Tweets"
  - filter: Twitter
    title: Two-Factor Authentication
    description: Use an authenticator app or security key instead of SMS
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Security and Account Access
    - 3. Tap Security
    - 4. Tap Two-Factor Authentication
    - 5. Select Authenticator App or Security Key"
  - filter: Twitter
    title: Revoke Connected Apps
    description: Remove unused OAuth app permissions from your account
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Security and Account Access
    - 3. Tap Apps and Sessions
    - 4. Tap Connected Apps
    - 5. Revoke unused apps"
  - filter: Twitter
    title: Restrict Direct Messages
    description: Disable receiving DMs from accounts you do not follow
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Direct Messages
    - 4. Turn off Allow Message Requests From Everyone"
  - filter: Twitter
    title: Keyword Mute Filters
    description: Reduce unwanted content exposure using mute and block filters
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Privacy and Safety
    - 3. Tap Mute and Block
    - 4. Tap Muted Keywords
    - 5. Add keywords to mute"
  - filter: WhatsApp
    title: Restrict Last Seen and About
    description: '"Limit visibility of last seen'
    steps:
    - photo
  - filter: WhatsApp
    title: Disable Read Receipts
    description: Prevent senders from seeing when you have read their messages
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy
    - 3. Toggle Read Receipts off"
  - filter: WhatsApp
    title: Restrict Group Invites
    description: Allow only your contacts to add you to groups
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy
    - 3. Tap Groups
    - 4. Set to My Contacts"
  - filter: WhatsApp
    title: Enable Disappearing Messages
    description: Set new chats to auto-delete messages by default
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy
    - 3. Tap Default Message Timer
    - 4. Set duration for new chats"
  - filter: WhatsApp
    title: Two-Step Verification
    description: Add a PIN required to re-register your phone number
    steps:
    - '"1. Open Settings'
    - 2. Tap Account
    - 3. Tap Two-Step Verification
    - 4. Tap Enable
    - 5. Set a six-digit PIN"
  - filter: WhatsApp
    title: Audit Linked Devices
    description: Review and remove old or unused linked device sessions
    steps:
    - '"1. Open Settings'
    - 2. Tap Linked Devices
    - 3. Review active sessions
    - 4. Log out unused devices"
  - filter: WhatsApp
    title: Secure Chat Backup
    description: Disable cloud backup or enable end-to-end encrypted backup
    steps:
    - '"1. Open Settings'
    - 2. Tap Chats
    - 3. Tap Chat Backup
    - 4. Turn off auto backup or enable End-to-End Encrypted Backup"
  - filter: WhatsApp
    title: Block Unknown Numbers
    description: Manually block and report spam or unrecognized contacts
    steps:
    - '"1. Open the chat from unknown number'
    - 2. Tap contact name
    - 3. Tap Block
    - 4. Optionally tap Report"
  - filter: Chrome
    title: Limit Sync Data
    description: Disable or restrict sync to avoid storing history and passwords
      in the cloud
    steps:
    - '"1. Open Settings'
    - 2. Tap You and Google
    - 3. Tap Sync and Google Services
    - 4. Turn off sync or select specific items to exclude"
  - filter: Chrome
    title: Block Third-Party Cookies
    description: Prevent cross-site tracking cookies from being set
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy and Security
    - 3. Tap Third-Party Cookies
    - 4. Select Block Third-Party Cookies"
  - filter: Chrome
    title: Disable Ad Privacy Features
    description: '"Turn off ad topics'
    steps:
    - site-suggested ads
  - filter: Chrome
    title: Configure Safe Browsing Level
    description: Choose Standard or Enhanced protection based on your data-sharing
      preference
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy and Security
    - 3. Tap Safe Browsing
    - 4. Select Standard or Enhanced Protection"
  - filter: Chrome
    title: Default-Deny Site Permissions
    description: '"Set location'
    steps:
    - camera
  - filter: Chrome
    title: Clear Cookies on Exit
    description: Automatically delete cookies when the browser closes
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy and Security
    - 3. Tap Cookies and Other Site Data
    - 4. Enable Clear Cookies When You Close All Windows"
  - filter: Chrome
    title: Enable Do Not Track
    description: Send a do-not-track signal to visited sites
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy and Security
    - 3. Tap Cookies and Other Site Data
    - 4. Toggle Send a Do Not Track Request on"
  - filter: Chrome
    title: Separate Browsing Profiles
    description: Use distinct profiles for logged-in Google activity and general
      browsing
    steps:
    - '"1. Click profile icon'
    - 2. Tap Add
    - 3. Create a new profile
    - 4. Sign in only on the dedicated profile"
  - filter: Chrome
    title: Install Tracker Blocker
    description: Use an extension like uBlock Origin to block ads and trackers
    steps:
    - '"1. Open Chrome Web Store'
    - 2. Search uBlock Origin
    - 3. Click Add to Chrome
    - 4. Confirm installation"
  - filter: Chrome
    title: Disable Network Prediction
    description: Turn off page preloading to avoid leaking browsing intent
    steps:
    - '"1. Open Settings'
    - 2. Tap Privacy and Security
    - 3. Tap Preload Pages
    - 4. Select No Preloading"
  - filter: LinkedIn
    title: Private Profile Viewing
    description: Browse profiles anonymously or in semi-private mode
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Visibility
    - 3. Tap Profile Viewing Options
    - 4. Select Private or Semi-Private Mode"
  - filter: LinkedIn
    title: Trim Public Profile Visibility
    description: Hide connections list and limit public profile details
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Visibility
    - 3. Tap Edit Your Public Profile
    - 4. Toggle off unwanted sections including Connections"
  - filter: LinkedIn
    title: Disable Off-LinkedIn Activity Tracking
    description: Turn off use of activity outside LinkedIn for ad targeting
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Data Privacy
    - 3. Tap Off-LinkedIn Activity
    - 4. Turn off"
  - filter: LinkedIn
    title: Restrict Email and Connections Visibility
    description: Set email address and connection list visible only to you
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Visibility
    - 3. Tap Who Can See Your Email
    - 4. Set to Only You
    - 5. Repeat for Connections"
  - filter: LinkedIn
    title: Two-Factor Authentication
    description: Enable 2FA for account login
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Sign In and Security
    - 3. Tap Two-Step Verification
    - 4. Turn on and choose method"
  - filter: LinkedIn
    title: Disable Contact Sync
    description: Turn off syncing of phone or email contacts
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Data Privacy
    - 3. Tap Sync Contacts
    - 4. Turn off"
  - filter: LinkedIn
    title: Hide Job Seeking Signal
    description: Disable notifying your network when you are open to work
    steps:
    - '"1. Open Job Seeking Preferences'
    - 2. Tap Open to Work
    - 3. Set visibility to Recruiters Only or turn off"
  - filter: LinkedIn
    title: Opt Out of Research Participation
    description: Disable salary and research data sharing programs
    steps:
    - '"1. Open Settings and Privacy'
    - 2. Tap Data Privacy
    - 3. Tap Research Invitations or Salary
    - 4. Opt out"
  - filter: GitHub
    title: Mandatory Two-Factor Authentication
    description: Require 2FA via authenticator app or hardware security key
    steps:
    - '"1. Open Settings'
    - 2. Tap Password and Authentication
    - 3. Click Enable Two-Factor Authentication
    - 4. Set up authenticator app or security key"
  - filter: GitHub
    title: Audit SSH Keys
    description: Review and remove stale or unused SSH keys
    steps:
    - '"1. Open Settings'
    - 2. Tap SSH and GPG Keys
    - 3. Review listed keys
    - 4. Delete unused ones"
  - filter: GitHub
    title: Use Fine-Grained Tokens
    description: Prefer scoped personal access tokens with expiry over classic tokens
    steps:
    - '"1. Open Settings'
    - 2. Tap Developer Settings
    - 3. Tap Personal Access Tokens
    - 4. Generate a Fine-Grained Token with limited scope and expiry"
  - filter: GitHub
    title: Keep Email Address Private
    description: Hide your email and block it from being exposed via command-line
      pushes
    steps:
    - '"1. Open Settings'
    - 2. Tap Emails
    - 3. Enable Keep My Email Address Private
    - 4. Enable Block Command Line Pushes That Expose My Email"
  - filter: GitHub
    title: Hide Private Contribution Activity
    description: Prevent private repo activity from showing on your public timeline
    steps:
    - '"1. Open your profile'
    - 2. Click Edit Profile
    - 3. Toggle Include Private Contributions on My Profile as desired
    - 4. Save changes"
  - filter: GitHub
    title: Revoke Unused OAuth Apps
    description: Remove third-party application access you no longer use
    steps:
    - '"1. Open Settings'
    - 2. Tap Applications
    - 3. Tap Authorized OAuth Apps
    - 4. Revoke unused apps"
  - filter: GitHub
    title: Review Organization Access
    description: Check which organizations can view your account data
    steps:
    - '"1. Open Settings'
    - 2. Tap Organizations
    - 3. Review membership list
    - 4. Leave or adjust visibility for unwanted orgs"
  - filter: GitHub
    title: Enable Commit Signing
    description: Sign commits with GPG or SSH to prevent impersonation
    steps:
    - '"1. Generate a GPG or SSH signing key'
    - 2. Open Settings
    - 3. Tap SSH and GPG Keys
    - 4. Add the signing key
    - 5. Configure git to sign commits by default"
  realizeEntries: 0
  processData: 0
